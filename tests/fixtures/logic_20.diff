+def total(order, tax_rate=0.0, coupon=None):
+    # Sum line items, then apply coupon and tax.
+    subtotal = 0
+    for item in order.items:
+        item.validate()
+        if item.quantity <= 0:
+            continue
+        subtotal += item.price * item.quantity
+    if coupon is not None:
+        if coupon.expired:
+            raise ValueError("coupon expired")
+        subtotal -= min(coupon.amount, subtotal)
+    tax = subtotal * tax_rate
+    result = subtotal + tax
+    if result < 0:
+        result = 0
+    rounded = math.floor(result * 100) / 100
+    logging.debug("total %s", rounded)
+    return rounded
